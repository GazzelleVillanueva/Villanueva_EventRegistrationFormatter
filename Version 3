from datetime import date

# Ask for required inputs and clean extra spaces
first_name = input("Enter student first name: ").strip()
last_name = input("Enter student last name: ").strip()
section = input("Enter section: ").strip()
event_name = input("Enter event name: ").strip()
event_year = int(input("Enter event year: "))
event_month = int(input("Enter event month: "))
event_day = int(input("Enter event day: "))

# Format text using string methods
full_name = f"{first_name} {last_name}".title()
name_code = full_name.upper()
formatted_section = section.upper()
formatted_event = event_name.title()

# Format date using datetime
event_date = date(event_year, event_month, event_day)
readable_date = f"{event_date.strftime('%B')} {event_date.day}, {event_date.year}"

# Display complete formatted output matching the sample
print("\nStudent Event Registration Summary\n")
print("Name:", full_name)
print("Name Code:", name_code)
print("Section:", formatted_section)
print("Event:", formatted_event)
print("Event Date:", readable_date)
print("Language Used: Python")
print("String Feature Used: strip(), title(), upper()")
print("Date/Time Feature Used: datetime")
print("\nRegistration record created successfully.")
